# Refuses commits on main, checks the formatting, and checks the GitHub workflows when they are
# staged. Install with `make hooks`.

set -eu

if [ "$(git symbolic-ref --short -q HEAD || true)" = "main" ]; then
    echo "Refusing to commit on main. Create a branch first: git switch -c <name>" >&2
    exit 1
fi

make fmt

# Only the workflows that this commit adds or changes. Without actionlint, the commit still
# goes through, and CI checks the workflows anyway.
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR -- '.github/workflows/*.yml')" ]; then
    if command -v actionlint >/dev/null 2>&1; then
        make actionlint
    else
        echo "Note: actionlint is not installed, so the workflows were not checked. CI checks them." >&2
    fi
fi
