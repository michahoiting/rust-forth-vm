# Refuses commits on main, and checks the formatting. Install with `make hooks`.

set -eu

if [ "$(git symbolic-ref --short -q HEAD || true)" = "main" ]; then
    echo "Refusing to commit on main. Create a branch first: git switch -c <name>" >&2
    exit 1
fi

make fmt
